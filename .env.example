# ClawViewer Enterprise Environment Configuration

# Application
CLAWVIEWER_ENV=development
CLAWVIEWER_LOG_LEVEL=info
CLAWVIEWER_LOG_FORMAT=json

# Security
CLAWVIEWER_JWT_SECRET=change-me-in-production
CLAWVIEWER_SESSION_TIMEOUT=3600
CLAWVIEWER_MAX_LOGIN_ATTEMPTS=5
CLAWVIEWER_REQUIRE_MFA=false

# Network
CLAWVIEWER_SIGNALING_URL=wss://signal.clawviewer.dev
CLAWVIEWER_STUN_SERVERS=stun:stun.l.google.com:19302
CLAWVIEWER_TURN_URL=turn:turn.clawviewer.dev:3478
CLAWVIEWER_TURN_USERNAME=
CLAWVIEWER_TURN_PASSWORD=

# Monitoring
CLAWVIEWER_METRICS_ENABLED=true
CLAWVIEWER_METRICS_PORT=9090
CLAWVIEWER_HEALTH_CHECK_INTERVAL=30

# Capture
CLAWVIEWER_DEFAULT_FPS=30
CLAWVIEWER_MAX_FPS=60
CLAWVIEWER_HARDWARE_ACCELERATION=true
CLAWVIEWER_CAPTURE_AUDIO=true
